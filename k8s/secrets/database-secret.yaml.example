apiVersion: v1
kind: Secret
metadata:
  name: database-secret
  # 注意：部署時需要使用 -n 參數指定命名空間
  # 例如：kubectl apply -f database-secret.yaml -n passontw-services-staging
type: Opaque
stringData:
  # 資料庫配置 - 使用 Kubernetes 內部域名
  # 格式：<service-name>.<namespace>.svc.cluster.local
  # PostgreSQL 服務在 postgresql namespace
  DB_HOST=postgresql.postgresql.svc.cluster.local
  DB_PORT=5432
  DB_NAME=token_admin
  DB_USER=postgres
  DB_PASSWORD=postgres123
  DB_SSL_MODE=disable
  DB_MAX_IDLE_CONNS=10
  DB_MAX_OPEN_CONNS=100
  DB_CONN_MAX_LIFETIME=3600
  DB_CONN_MAX_IDLE_TIME=1800

