apiVersion: v1
kind: Secret
metadata:
  name: database-secret
  namespace: passontw-services
type: Opaque
stringData:
  # 請將以下值替換為實際的資料庫配置
  DB_HOST: "your-postgres-host"
  DB_PORT: "5432"
  DB_USER: "your-db-user"
  DB_PASSWORD: "your-db-password"
  DB_NAME: "token_services"
  DB_SSLMODE: "disable"

