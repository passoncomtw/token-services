apiVersion: v1
kind: Secret
metadata:
  name: redis-secret
  # 注意：部署時需要使用 -n 參數指定命名空間
  # 例如：kubectl apply -f redis-secret.yaml -n passontw-services-staging
type: Opaque
stringData:
  # Redis 配置 - 使用 Kubernetes 內部域名
  # 格式：<service-name>.<namespace>.svc.cluster.local
  # Redis 服務在 redis-cluster namespace
  REDIS_HOST=redis-cluster.redis-cluster.svc.cluster.local
  REDIS_PORT=6379
  REDIS_PASSWORD=7vOXkhBGfT  # Redis 密碼（如果有設置）
  REDIS_DB=0       # Redis 資料庫編號（0-15）

