HTTP_PORT=8080

CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

SWAGGER_BASE_DOMAIN=

SWAGGER_ENABLED=true

DB_HOST=localhost
DB_PORT=5432
