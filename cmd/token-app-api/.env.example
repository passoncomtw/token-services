# Token App API 環境變數配置範例
# 複製此檔案為 .env 並填入實際值

# ============================================
# HTTP Server 配置
# ============================================
HTTP_PORT=8080
APP_PORT=8080

# ============================================
# CORS 配置
# ============================================
# 允許的前端來源（多個來源用逗號分隔）
# 開發環境範例：
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
# 生產環境範例：
# CORS_ALLOW_ORIGINS=https://token-app-web.passon.tw,https://app.passon.tw

# ============================================
# Swagger 配置
# ============================================
# Swagger UI 顯示的 Base URL（不含 https:// 前綴）
# 本地開發時留空，會自動使用本地 IP
SWAGGER_BASE_DOMAIN=
# 生產環境範例：
# SWAGGER_BASE_DOMAIN=token-app-api.passon.tw

SWAGGER_ENABLED=true

# ============================================
# Database 配置
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=passontw_token
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_SSL_MODE=disable

# Database 連接池配置
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=3600
DB_CONN_MAX_IDLE_TIME=1800

# ============================================
# Redis 配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT 配置
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ============================================
# Logging 配置
# ============================================
LOG_LEVEL=info
LOG_MODE=production
# 開發模式：LOG_MODE=development

# ============================================
# Application 配置
# ============================================
APP_ENV=development
APP_VERSION=1.0.0
MAX_CONNECTIONS=100
IDLE_TIMEOUT=120s
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
