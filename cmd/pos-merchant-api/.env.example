# POS Merchant API 環境變數配置範例
# 複製此檔案為 .env 並填入實際值

# ============================================
# HTTP Server 配置
# ============================================
HTTP_PORT=8080

# ============================================
# CORS 配置
# ============================================
# 允許的前端來源（多個來源用逗號分隔）
# 開發環境範例：
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
# 生產環境範例：
# CORS_ALLOW_ORIGINS=https://pos-merchant-web.passon.tw,https://merchant.passon.tw

# ============================================
# Swagger 配置
# ============================================
# Swagger UI 顯示的 Base URL（不含 https:// 前綴）
# 本地開發時留空，會自動使用本地 IP
SWAGGER_BASE_DOMAIN=
# 生產環境範例：
# SWAGGER_BASE_DOMAIN=pos-merchant-api.passon.tw

SWAGGER_ENABLED=true

# ============================================
# Database 配置
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=passontw_pos
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_SSL_MODE=disable

# Database 連接池配置
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=3600
DB_CONN_MAX_IDLE_TIME=1800

# ============================================
# JWT 配置
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ============================================
# Logging 配置
# ============================================
LOG_LEVEL=info
LOG_MODE=production
LOG_DEVELOPMENT=false
LOG_ENCODING=json
# 開發模式：
# LOG_MODE=development
# LOG_DEVELOPMENT=true
# LOG_ENCODING=console

# ============================================
# Application 配置
# ============================================
APP_ENV=development
APP_VERSION=1.0.0
