# ==================== HTTP Server ====================
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# ==================== JWT ====================
JWT_SECRET=your_super_secret_jwt_key_here_please_change_in_production

# ==================== Database (PostgreSQL) ====================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=test_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=3600
DB_CONN_MAX_IDLE_TIME=1800

# ==================== Redis (K8s 對外 IP) ====================
# 請將以下改為您的 k8s Redis 對外 IP 和 Port
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== Logging ====================
LOG_LEVEL=info
LOG_MODE=development

# ==================== Swagger UI =====================
SWAGGER_BASE_DOMAIN=http://localhost:8080
